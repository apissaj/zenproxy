{
  "model_alias": {
    "deepseek-v4-flash": "nemotron-3-ultra-free",
    "deepseek-v4-flash-free": "nemotron-3-ultra-free",
    "mimo-v2.5": "nemotron-3.5-lightning-free",
    "mimo-v2.5-free": "nemotron-3.5-lightning-free",
    "mimo-v2.6-flash": "mimo-v2.6-flash-free",
    "ling-3.0-flash": "ling-3.0-flash-fin-free",
    "ling-3.0": "ling-3.0-flash-fin-free",
    "ling-3.0-flash-fin": "ling-3.0-flash-fin-free",
    "nemotron-3-ultra": "nemotron-3-ultra-free",
    "nemotron-3.5-lightning": "nemotron-3.5-lightning-free",
    "space-bunny": "space-bunny-free",
    "muse-spark-1.2-contributor": "muse-spark-1.2-contributor-free",
    "muse-spark-1.3-contributor": "muse-spark-1.3-contributor-free",
    "big-pickle": "big-pickle"
  },
  "reasoning_effort_map": {
    "minimal": "low",
    "medium": "medium",
    "high": "high"
  },
  "force_disable_thinking": false,

  "rate_limit": {
    "enabled": true,
    "requests_per_minute": 60,
    "tokens_per_minute": 500000,
    "exempt_keys": []
  },

  "usage": {
    "enabled": true,
    "persist_path": "usage.json",
    "max_keys": 1000,
    "cost_per_1k_input_tokens": 0.001,
    "cost_per_1k_output_tokens": 0.002
  },

  "key_auth": {
    "enabled": true,
    "keys_path": "keys.json",
    "allow_public": true
  },

  "dashboard_auth": {
    "enabled": true,
    "token": "admin-secret-123"
  },

  "upstream_pool": {
    "enabled": true,
    "keys": [
      "sk-your-main-key-here",
      "sk-your-backup-key-here"
    ],
    "cooldown_secs": 60
  },
  "proxy_pool": {
    "enabled": false,
    "proxies": [
      "http://proxy1.example.com:8080",
      "http://user:pass@proxy2.example.com:3128"
    ],
    "cooldown_secs": 60
  }
}